<Window x:Class="FlyBrain.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyBrain" Width="1560" Height="960" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1016" Foreground="#E7EDF5">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="BrainButton" TargetType="Button">
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#2B9CCB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#121A23" Padding="16,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FlyBrain" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Margin="14,6,0,0" Foreground="#8EA1B6" Text="{Binding ActiveModuleTitle}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#AAB7C5"
                    IsChecked="{Binding EagerWholeDomain}" IsEnabled="{Binding CanChangeBrainSettings}"
                    Content="Whole brain (139k neurons, slower start)"/>
          <Border Background="#1A2530" CornerRadius="8" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="11" Height="11" Margin="0,3,8,0" Fill="{Binding BrainIndicatorColor}"/>
              <TextBlock FontWeight="SemiBold" Text="{Binding BrainStateText}"/>
              <TextBlock Margin="10,0,0,0" Foreground="#AAB7C5" MaxWidth="520" TextTrimming="CharacterEllipsis"
                         Text="{Binding BrainMessage}" ToolTip="{Binding BrainMessage}"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource BrainButton}" Background="{Binding BrainButtonColor}"
                  Command="{Binding ToggleBrainCommand}" Content="{Binding BrainButtonText}"/>
          <ToggleButton Margin="8,0,0,0" Padding="10,8" IsChecked="{Binding IsLogVisible}" Content="LOG"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#2A2412" Padding="16,8"
            Visibility="{Binding IsSetupNeeded, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <ToggleButton DockPanel.Dock="Right" Padding="12,6" IsChecked="{Binding IsSetupPanelVisible}" Content="SETUP..."/>
        <TextBlock VerticalAlignment="Center" Foreground="#F2C14E" Text="{Binding SetupSummary}"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#151E28" Padding="16,10"
            Visibility="{Binding IsSetupPanelVisible, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="FIRST-RUN SETUP"/>
        <ItemsControl Margin="0,6,0,6" ItemsSource="{Binding SetupChecks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Width="22" FontWeight="Bold" Foreground="#5CDB95" Text="OK">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                          <Setter Property="Text" Value="!"/>
                          <Setter Property="Foreground" Value="#FF8E8E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Width="190" Text="{Binding Name}"/>
                <TextBlock Foreground="#AAB7C5" Text="{Binding Detail}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource BrainButton}" Margin="0" Command="{Binding CreatePythonCommand}" Content="1. CREATE PYTHON ENVIRONMENT"/>
          <Button Style="{StaticResource BrainButton}" Command="{Binding PrepareDataCommand}" Content="2. DOWNLOAD BRAIN DATA"/>
          <Button Style="{StaticResource BrainButton}" Background="#3A4A5C" Command="{Binding RecheckCommand}" Content="RE-CHECK"/>
          <Button Style="{StaticResource BrainButton}" Background="#B5523B" Command="{Binding CancelSetupCommand}" Content="CANCEL"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#0F151C" Height="170"
            Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
      <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0" Foreground="#AAB7C5"
               FontFamily="Consolas" FontSize="11"/>
    </Border>

    <Border DockPanel.Dock="Left" Width="210" Background="#121A23" Padding="10">
      <StackPanel>
        <TextBlock Margin="6,4,0,8" Foreground="#8EA1B6" Text="MODULES"/>
        <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                 IsEnabled="{Binding CanSwitchModules}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#E7EDF5" Text="{Binding DisplayName}"/>
                <TextBlock FontSize="11" Foreground="#8EA1B6" TextWrapping="Wrap" Text="{Binding Description}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <ContentControl Content="{Binding CurrentView}"/>
  </DockPanel>
</Window>
