<UserControl x:Class="Topo.Module.TopoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#10151C" Foreground="#E7EDF5">
  <UserControl.Resources>
    <Style TargetType="Border"><Setter Property="Background" Value="#18212C"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#2B9CCB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,2,0,2"/></Style>
  </UserControl.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Foreground="#8EA1B6" Text="{Binding Mode}"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Command="{Binding NeuralDecodeModeCommand}" Content="DECODE MODE"/>
        <Button Command="{Binding AutonomousSearchModeCommand}" Content="SEARCH MODE"/>
        <Border Background="#21302A" Padding="12,6" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#5CDB95" Margin="0,4,8,0"/><TextBlock FontWeight="SemiBold" Text="{Binding BrainState}"/><TextBlock Margin="10,0,0,0" Foreground="#AAB7C5" Text="{Binding BrainDetail}"/></StackPanel></Border>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="225"/></Grid.RowDefinitions>
      <Border Grid.Column="0" Grid.Row="0" Padding="0" Margin="0,0,14,14"><Grid><wv2:WebView2 x:Name="MapView"/><TextBlock x:Name="MapFallback" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C5" Text="Map unavailable — manual coordinate decode and autonomous search remain available."/></Grid></Border>
      <ScrollViewer Grid.Column="1" Grid.Row="0" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Margin="0,0,0,12"><StackPanel><TextBlock Foreground="#8EA1B6" Text="TARGET"/><TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Target}"/><TextBlock Margin="0,10,0,0" Foreground="#8EA1B6" Text="CURRENT DECODED PREDICTION"/><TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Decoded}"/><Separator Margin="0,10"/><TextBlock Text="{Binding AngularError, StringFormat=Angular error: {0:F3}°}"/><TextBlock Text="{Binding Reward, StringFormat=REWARD: {0:F3}}" FontSize="18" FontWeight="SemiBold"/><TextBlock Foreground="#8EA1B6" FontSize="12" Text="application-level dopamine-like signal"/><ProgressBar Height="10" Margin="0,8,0,0" Maximum="1" Value="{Binding Reward}"/></StackPanel></Border>
        <Border Margin="0,0,0,12"><StackPanel><TextBlock FontWeight="SemiBold" Text="AUTONOMOUS SEARCH"/><TextBlock Text="{Binding SearchStatus, StringFormat=Status: {0}}"/><TextBlock Text="{Binding SearchIteration, StringFormat=Iteration: {0} / 250}"/><TextBlock Text="{Binding SearchSeed, StringFormat=Seed: {0}}"/><TextBlock Text="{Binding SearchRadius, StringFormat=Radius: {0}°}"/><TextBlock Text="{Binding CurrentProposed, StringFormat=Proposed: {0}}"/><TextBlock Text="{Binding CurrentDecoded, StringFormat=Decoded: {0}}"/><TextBlock Text="{Binding BestDecoded, StringFormat=Best decoded: {0}}"/><TextBlock Text="{Binding BestReward, StringFormat=Best reward: {0:F3}}"/><TextBlock Text="{Binding BestAngularError, StringFormat=Best error: {0:F3}°}"/></StackPanel></Border>
        <Border><StackPanel><TextBlock FontWeight="SemiBold" Text="NEURAL STATE"/><TextBlock Text="{Binding SimulationStep, StringFormat=Simulation step: {0}}"/><TextBlock Text="{Binding CurrentToken, StringFormat=Current token: {0}}"/><TextBlock Text="Readout roots: 128 · raw: 384 · retained: 128"/><TextBlock Text="{Binding MaximumMembrane, StringFormat=Maximum membrane Δ: {0:F4} mV}"/><TextBlock Text="{Binding TotalSpikes, StringFormat=Total spikes: {0}}"/><TextBlock Text="{Binding ActiveFraction, StringFormat=Active fraction: {0:P3}}"/><TextBlock Text="{Binding SafetyStatus, StringFormat=Safety: {0}}"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Border Grid.Column="0" Grid.Row="1" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontWeight="SemiBold" Text="TOKEN PIPELINE · real neural execution"/><ItemsControl Grid.Row="1" ItemsSource="{Binding Tokens}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="4" Padding="9" Background="#22303E"><StackPanel><TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding Expected}"/><TextBlock HorizontalAlignment="Center" Foreground="#65D6FF" Text="{Binding Predicted}"/><TextBlock FontSize="10" Foreground="#AAB7C5" Text="{Binding State}"/><TextBlock FontSize="10" Text="{Binding Confidence, StringFormat={}{0:F3}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
      <Border Grid.Column="1" Grid.Row="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions><TextBlock FontWeight="SemiBold" Text="SEARCH HISTORY / LOG"/><ListBox Grid.Row="1" ItemsSource="{Binding SearchHistory}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Decoded, StringFormat=Decoded: {0}}"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" FontFamily="Consolas" FontSize="10" Foreground="#AAB7C5" Text="{Binding Log}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Grid></Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Padding="12" FontSize="18" Text="{Binding CoordinateText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Command="{Binding DecodeCommand}" Content="DECODE"/><Button Grid.Column="2" Command="{Binding CancelCommand}" Content="CANCEL"/><Button Grid.Column="3" Command="{Binding StartSearchCommand}" Content="START SEARCH"/><Button Grid.Column="4" Command="{Binding StopSearchCommand}" Content="STOP"/><Button Grid.Column="5" Command="{Binding ResetSearchCommand}" Content="RESET"/><Button Grid.Column="6" Command="{Binding ReconnectCommand}" Content="RECONNECT"/><TextBlock Grid.Column="0" VerticalAlignment="Bottom" Margin="4,-22,0,0" Foreground="#FF8E8E" Text="{Binding Error}"/></Grid>
  </Grid>
</UserControl>
